<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.MainController">

    <left>
        <VBox spacing="20" BorderPane.alignment="CENTER">
            <styleClass>
                <String>sidebar</String>
            </styleClass>
            <Label text="RadarMDF">
                <styleClass>
                    <String>title</String>
                </styleClass>
            </Label>
            <Button text="Product">
                <styleClass>
                    <String>menu-button</String>
                </styleClass>
            </Button>
            <Button text="Consult Product">
                <styleClass>
                    <String>menu-button</String>
                </styleClass>
            </Button>
            <Button text="Exit">
                <styleClass>
                    <String>menu-button</String>
                </styleClass>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <styleClass>
                <String>content</String>
            </styleClass>

            <Label text="RadarMDF">
                <styleClass>
                    <String>main-title</String>
                </styleClass>
            </Label>

            <!-- Botões novos para patrimônio -->
            <Button text="Cadastrar Patrimônio" fx:id="btnCadastrar" onAction="#handleCadastrar">
                <styleClass>
                    <String>action-button</String>
                </styleClass>
            </Button>
            <Button text="Consultar Patrimônio" fx:id="btnConsultar" onAction="#handleConsultar">
                <styleClass>
                    <String>action-button</String>
                    <String>secondary</String>
                </styleClass>
            </Button>

            <!-- Botão original de saída -->
            <Button text="Exit" onAction="#handleExit">
                <styleClass>
                    <String>action-button</String>
                </styleClass>
            </Button>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" padding="10">
            <styleClass>
                <String>info-box</String>
            </styleClass>
            <Label text="RadarMDF">
                <styleClass>
                    <String>info-title</String>
                </styleClass>
            </Label>
            <Label wrapText="true"
                   text="Sistema para registro e consulta de produtos da MDF Móveis. Projeto exemplo em JavaFX.">
                <styleClass>
                    <String>info-text</String>
                </styleClass>
            </Label>
        </VBox>
    </right>

</BorderPane>

