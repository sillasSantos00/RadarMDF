<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.app.controller.PatrimonioController"
      spacing="15" alignment="CENTER" padding="20">

    <Label text="Cadastro de Patrimônio" styleClass="main-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nº Patrimônio:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNumeroPatrimonio" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nome do Item:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNomeItem" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTipo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Preço:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPreco" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Setor:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSetor" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Cadastrar" onAction="#handleCadastrar"/>
        <Button text="Consultar" onAction="#handleConsultar"/>
    </HBox>

    <TableView fx:id="tabelaPatrimonios" prefHeight="200">
        <columns>
            <TableColumn text="ID" fx:id="colId"/>
            <TableColumn text="Nº Patrimônio" fx:id="colNumeroPatrimonio"/>
            <TableColumn text="Nome" fx:id="colNomeItem"/>
            <TableColumn text="Tipo" fx:id="colTipo"/>
            <TableColumn text="Preço" fx:id="colPreco"/>
            <TableColumn text="Setor" fx:id="colSetor"/>
        </columns>
    </TableView>

</VBox>
